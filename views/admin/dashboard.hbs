<div class="dashboard">
  <h1>Dashboard</h1>

  <div class="stats">
    <div class="stat-card">
      <div class="number">{{albumCount}}</div>
      <div class="label">Albums</div>
    </div>
    <div class="stat-card">
      <div class="number">{{trackCount}}</div>
      <div class="label">Tracks</div>
    </div>
    <div class="stat-card">
      <div class="number">{{artistCount}}</div>
      <div class="label">Artists</div>
    </div>
  </div>

  <h2>Recent Albums</h2>
  {{#if albums.length}}
    <ul class="list">
      {{#each albums}}
        <li>{{this.title}} ({{this.trackCount}} tracks)</li>
      {{/each}}
    </ul>
  {{else}}
    <p class="empty">No albums yet.</p>
  {{/if}}

  <h2>Recent Tracks</h2>
  {{#if tracks.length}}
    <ul class="list">
      {{#each tracks}}
        <li>{{this.title}}</li>
      {{/each}}
    </ul>
  {{else}}
    <p class="empty">No tracks yet.</p>
  {{/if}}
</div>