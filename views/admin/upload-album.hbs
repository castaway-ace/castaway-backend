<h1>Upload Album</h1>

{{#if success}}
  <div class="success">{{success}} (ID: {{trackIds}})</div>
{{/if}}

{{#if error}}
  <div class="error">{{error}}</div>
{{/if}}

<form method="POST" action="/admin/upload/album" enctype="multipart/form-data">
  <label for="album">Audio Files</label>
  <input type="file" name="album" id="album" accept="audio/*" required multiple webkitdirectory />

  <button type="submit">Upload</button>
</form>