# ─── App ─────────────────────────────────────────────────────────────────────

# Node runtime mode. Affects framework and library defaults (error verbosity,
# logger formatting, etc).
# Allowed: development | production
NODE_ENV=development

# Port the NestJS app listens to.
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# Full Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:port/mydatabase

# ─── Auth ────────────────────────────────────────────────────────────────────

# Secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Access token lifetime in seconds. Default 900 (15 minutes).
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in seconds. Default 2592000 (30 days).
JWT_REFRESH_TTL_SECONDS=2592000

# ─── Storage ─────────────────────────────────────────────────────────────────\
STORAGE_ENDPOINT=storage_endpoint
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=storage_access_key
STORAGE_SECRET_KEY=storage_secret_key
STORAGE_BUCKET=storage_bucket_name
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# ─── OAuth: Google ───────────────────────────────────────────────────────────

# Create at https://console.cloud.google.com/ → APIs & Services → Credentials.
# The callback URL here must match exactly what you register in the console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── OAuth: Facebook ─────────────────────────────────────────────────────────

# Create at https://developers.facebook.com/ → My Apps.
# Facebook requires an https callback in production; http is fine locally.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback