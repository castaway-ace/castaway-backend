# Example environment file. Copy to `.env` and replace every `change-me` with a
# real value. `.env` is gitignored — never commit real secrets. Generate strong
# secrets with e.g. `openssl rand -base64 32`.

# Postgres connection string used by Prisma. Keep the credentials in sync with
# the POSTGRES_* values below; host `db` is the compose service name.
DATABASE_URL="postgres://castaway-admin:change-me@db:5432/castaway"

# Database Config
POSTGRES_DB="castaway"
POSTGRES_USER="castaway-admin"
POSTGRES_PASSWORD="change-me"

# JWT Secrets (generate each with: openssl rand -base64 32)
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRATION="30d"

# Storage Config (S3 / MinIO)
STORAGE_REGION="us-west-2"
STORAGE_ACCESS_KEY="change-me"                           # also the MinIO root user
STORAGE_SECRET_ACCESS_KEY="change-me"                    # also the MinIO root password
STORAGE_ENDPOINT="http://storage:9000"                   # internal S3 endpoint (compose service)
STORAGE_PRESIGNED_ENDPOINT="https://storage.example.com" # client-reachable host baked into presigned URLs

# Public base host for edge-cacheable cover art. Optional: defaults to
# STORAGE_PRESIGNED_ENDPOINT. Point at a CDN hostname to serve album/artist art
# through a cache (see README → Object storage).
# CDN_BASE_URL="https://cdn.example.com"

# Storage Buckets (optional; unset falls back to these defaults)
STORAGE_TRACKS_BUCKET="tracks"
STORAGE_ALBUM_ART_BUCKET="album-art"
STORAGE_ARTIST_IMAGE_BUCKET="artist-image"
STORAGE_STAGING_BUCKET="upload-staging"

# Cloudflare Tunnel token (prod ingress)
CLOUDFLARE_TUNNEL_TOKEN="change-me"

# Admin Credentials (seed the initial admin account)
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Swagger Credentials (basic-auth for /docs in dev)
SWAGGER_USERNAME="swagger-user"
SWAGGER_PASSWORD="change-me"

# Redis (BullMQ transport; compose service name `redis`)
REDIS_URL="redis://redis:6379"
