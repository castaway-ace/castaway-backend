# App

# Runtime mode. Use 'development' locally, 'production' when deployed.
NODE_ENV=development
APP_PORT=3000

# Local Postgres container credentials (dev only, unused in production)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# For local Postgres: set DATABASE_URL only, leave DIRECT_URL unset
# For Supabase (production): set both DATABASE_URL (pooler) and DIRECT_URL (direct)
DATABASE_URL=
DIRECT_URL=

# Storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# JWT Secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=
BCRYPT_ROUNDS=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Facebook OAuth Configuration
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Production only
CLOUDFLARE_TUNNEL_TOKEN=