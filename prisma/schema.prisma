// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  Admin
  User
}

enum AuthProvider {
  Google
  Facebook
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  userName  String?  @unique @map("user_name")
  avatarUrl String?  @map("avatar_url")
  password  String?
  role      Role     @default(User)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  accounts             Account[]
  refreshTokens        RefreshToken[]
  playlists            Playlist[]
  mediaFileAnnotations MediaFileAnnotation[]
  albumAnnotations     AlbumAnnotation[]
  artistAnnotations    ArtistAnnotation[]
  scrobbleBuffers      ScrobbleBuffer[]
  scrobbles            Scrobble[]

  @@map("users")
}

model Account {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  providerId String       @map("provider_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("accounts")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  deviceName String?  @map("device_name")
  deviceType String?  @map("device_type")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Music Entities ──────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  albums             Album[]
  albumArtistCredits AlbumArtist[]
  mediaFiles         MediaFile[]       @relation("TrackArtist")
  albumArtistFiles   MediaFile[]       @relation("TrackAlbumArtist")
  mediaFileCredits   MediaFileArtist[]
  artistAnnotations  ArtistAnnotation[]

  @@index([name])
  @@map("artists")
}

model Album {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  releaseDate   DateTime @map("release_date") @db.Date
  compilation   Boolean  @default(false)
  genres        String[]
  albumArtistId String   @map("album_artist_id") @db.Uuid
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  albumArtist      Artist            @relation(fields: [albumArtistId], references: [id])
  albumArtists     AlbumArtist[]
  mediaFiles       MediaFile[]
  albumAnnotations AlbumAnnotation[]

  @@index([albumArtistId])
  @@index([createdAt])
  @@index([name])
  @@index([genres], type: Gin)
  @@map("albums")
}

model AlbumArtist {
  albumId  String @map("album_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  role     String @default("")

  album  Album  @relation(fields: [albumId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@id([albumId, artistId])
  @@index([albumId])
  @@index([role])
  @@map("album_artists")
}

// ─── Media Files ─────────────────────────────────────────────────────────────

model MediaFile {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  path          String    @default("") @db.VarChar(255)
  albumId       String    @map("album_id") @db.Uuid
  artistId      String    @map("artist_id") @db.Uuid
  albumArtistId String    @map("album_artist_id") @db.Uuid
  trackNumber   Int       @map("track_number")
  size          Int       @default(0)
  suffix        String    @default("") @db.VarChar(255)
  discNumber    Int       @default(0) @map("disc_number")
  bitRate       Int       @default(0) @map("bit_rate")
  lyrics        Json      @default("[]")
  releaseDate   DateTime? @map("release_date") @db.Date
  sampleRate    Int       @default(0) @map("sample_rate")
  genres        String[]
  bitDepth      Int       @default(0) @map("bit_depth")
  duration      Int
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  album       Album  @relation(fields: [albumId], references: [id])
  artist      Artist @relation("TrackArtist", fields: [artistId], references: [id])
  albumArtist Artist @relation("TrackAlbumArtist", fields: [albumArtistId], references: [id])

  mediaFileArtists     MediaFileArtist[]
  playlistTracks       PlaylistTrack[]
  mediaFileAnnotations MediaFileAnnotation[]
  scrobbleBuffers      ScrobbleBuffer[]
  scrobbles            Scrobble[]

  @@index([title])
  @@index([albumId])
  @@index([artistId])
  @@index([discNumber, trackNumber])
  @@index([genres], type: Gin)
  @@map("media_files")
}

model MediaFileArtist {
  mediaFileId String @map("media_file_id") @db.Uuid
  artistId    String @map("artist_id") @db.Uuid
  role        String @default("")
  subRole     String @default("") @map("sub_role")

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])
  artist    Artist    @relation(fields: [artistId], references: [id])

  @@id([mediaFileId, artistId])
  @@index([mediaFileId])
  @@index([role])
  @@map("media_file_artists")
}

// ─── Playlists ───────────────────────────────────────────────────────────────

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  public      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  ownerId     String   @map("owner_id") @db.Uuid

  owner  User            @relation(fields: [ownerId], references: [id])
  tracks PlaylistTrack[]

  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("playlists")
}

model PlaylistTrack {
  id          String @id @default(uuid()) @db.Uuid
  playlistId  String @map("playlist_id") @db.Uuid
  mediaFileId String @map("media_file_id") @db.Uuid
  position    Int

  playlist  Playlist  @relation(fields: [playlistId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@unique([playlistId, position])
  @@map("playlist_tracks")
}

// ─── Annotations ─────────────────────────────────────────────────────────────

model MediaFileAnnotation {
  userId      String    @map("user_id") @db.Uuid
  mediaFileId String    @map("media_file_id") @db.Uuid
  playCount   Int       @default(0) @map("play_count")
  playDate    DateTime? @map("play_date")
  liked       Boolean   @default(false)
  likedAt     DateTime? @map("liked_at")

  user      User      @relation(fields: [userId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@id([userId, mediaFileId])
  @@map("media_file_annotations")
}

model AlbumAnnotation {
  userId  String    @map("user_id") @db.Uuid
  albumId String    @map("album_id") @db.Uuid
  liked   Boolean   @default(false)
  likedAt DateTime? @map("liked_at")

  user  User  @relation(fields: [userId], references: [id])
  album Album @relation(fields: [albumId], references: [id])

  @@id([userId, albumId])
  @@map("album_annotations")
}

model ArtistAnnotation {
  userId   String    @map("user_id") @db.Uuid
  artistId String    @map("artist_id") @db.Uuid
  liked    Boolean   @default(false)
  likedAt  DateTime? @map("liked_at")

  user   User   @relation(fields: [userId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@id([userId, artistId])
  @@map("artist_annotations")
}

// ─── Scrobbling ──────────────────────────────────────────────────────────────

model ScrobbleBuffer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  service     String
  mediaFileId String   @map("media_file_id") @db.Uuid
  playTime    DateTime @map("play_time")
  enqueueTime DateTime @default(now()) @map("enqueue_time")

  user      User      @relation(fields: [userId], references: [id])
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@unique([userId, service, mediaFileId, playTime])
  @@map("scrobble_buffer")
}

model Scrobble {
  id             String   @id @default(uuid()) @db.Uuid
  mediaFileId    String   @map("media_file_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  submissionTime DateTime @map("submission_time")

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([submissionTime])
  @@map("scrobbles")
}