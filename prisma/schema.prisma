// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
}

enum ArtistRole {
  PRIMARY
  FEATURED
  PRODUCER
  COMPOSER
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?  @unique @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  password    String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accounts           Account[]
  refreshTokens      RefreshToken[]
  authorizationCodes AuthorizationCode[]
  playlists          Playlist[]
  playEvents         PlayEvent[]
  trackAnnotations   TrackAnnotation[]
  albumAnnotations   AlbumAnnotation[]
  artistAnnotations  ArtistAnnotation[]

  @@map("users")
}

model Account {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  providerId String       @map("provider_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  deviceName     String?   @map("device_name")
  deviceType     String?   @map("device_type")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedById   String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken?  @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthorizationCode {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique @map("code_hash")
  userId      String    @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("authorization_codes")
}

// ─── Genres ──────────────────────────────────────────────────────────────────

model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  albums AlbumGenre[]
  tracks TrackGenre[]

  @@map("genres")
}

model AlbumGenre {
  albumId String @map("album_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@index([genreId])
  @@map("album_genres")
}

model TrackGenre {
  trackId String @map("track_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId])
  @@map("track_genres")
}

// ─── Music Entities ──────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  imageKey  String?  @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  albumCredits      AlbumArtist[]
  trackCredits      TrackArtist[]
  artistAnnotations ArtistAnnotation[]

  @@index([name])
  @@map("artists")
}

model Album {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  releaseDate DateTime? @map("release_date") @db.Date
  compilation Boolean   @default(false)
  imageKey    String?   @map("image_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  albumArtists     AlbumArtist[]
  tracks           Track[]
  albumGenres      AlbumGenre[]
  albumAnnotations AlbumAnnotation[]

  @@index([createdAt])
  @@index([name])
  @@map("albums")
}

model AlbumArtist {
  albumId  String     @map("album_id") @db.Uuid
  artistId String     @map("artist_id") @db.Uuid
  role     ArtistRole @default(PRIMARY)

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([role])
  @@map("album_artists")
}

// ─── Tracks ──────────────────────────────────────────────────────────────────

model Track {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  fileKey     String    @unique @map("file_key")
  albumId     String    @map("album_id") @db.Uuid
  trackNumber Int       @map("track_number")
  discNumber  Int       @default(1) @map("disc_number")
  duration    Int
  size        Int?
  suffix      String?   @db.VarChar(16)
  bitRate     Int?      @map("bit_rate")
  sampleRate  Int?      @map("sample_rate")
  bitDepth    Int?      @map("bit_depth")
  releaseDate DateTime? @map("release_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackArtists     TrackArtist[]
  trackGenres      TrackGenre[]
  playlistTracks   PlaylistTrack[]
  playEvents       PlayEvent[]
  trackAnnotations TrackAnnotation[]

  @@index([title])
  @@index([albumId])
  @@index([discNumber, trackNumber])
  @@map("tracks")
}

model TrackArtist {
  trackId  String     @map("track_id") @db.Uuid
  artistId String     @map("artist_id") @db.Uuid
  role     ArtistRole @default(PRIMARY)
  subRole  String?    @map("sub_role")

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId, role])
  @@index([role])
  @@map("track_artists")
}

// ─── Playlists ───────────────────────────────────────────────────────────────

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  public      Boolean  @default(false)
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(uuid()) @db.Uuid
  playlistId String @map("playlist_id") @db.Uuid
  trackId    String @map("track_id") @db.Uuid
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
}

// ─── Listening History ───────────────────────────────────────────────────────

model PlayEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  playedAt  DateTime @default(now()) @map("played_at")
  playedMs  Int?     @map("played_ms")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
  @@index([trackId])
  @@map("play_events")
}

// ─── Annotations ─────────────────────────────────────────────────────────────

model TrackAnnotation {
  userId       String    @map("user_id") @db.Uuid
  trackId      String    @map("track_id") @db.Uuid
  playCount    Int       @default(0) @map("play_count")
  lastPlayedAt DateTime? @map("last_played_at")
  liked        Boolean   @default(false)
  likedAt      DateTime? @map("liked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, liked])
  @@index([userId, lastPlayedAt(sort: Desc)])
  @@map("track_annotations")
}

model AlbumAnnotation {
  userId  String    @map("user_id") @db.Uuid
  albumId String    @map("album_id") @db.Uuid
  liked   Boolean   @default(false)
  likedAt DateTime? @map("liked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@index([userId, liked])
  @@map("album_annotations")
}

model ArtistAnnotation {
  userId   String    @map("user_id") @db.Uuid
  artistId String    @map("artist_id") @db.Uuid
  liked    Boolean   @default(false)
  likedAt  DateTime? @map("liked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, liked])
  @@map("artist_annotations")
}