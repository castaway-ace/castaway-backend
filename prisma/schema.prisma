// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── User & Auth ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  userName  String   @unique @map("user_name")
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices           Device[]
  playlists         Playlist[]
  playHistories     PlayHistory[]
  trackAnnotations  TrackAnnotation[]
  albumAnnotations  AlbumAnnotation[]
  artistAnnotations ArtistAnnotation[]

  @@map("users")
}

model Device {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name  String
  model String

  activatedAt DateTime @default(now()) @map("activated_at")
  lastSeenAt  DateTime @default(now()) @map("last_used_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")

  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("TokenRotation")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Music Entities ───────────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  imageKey  String?  @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  albumArtists      AlbumArtist[]
  trackArtists      TrackArtist[]
  artistAnnotations ArtistAnnotation[]

  @@index([name])
  @@map("artists")
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  releaseDate DateTime @map("release_date") @db.Date
  compilation Boolean  @default(false)
  imageKey    String?  @map("image_key")
  genres      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  albumArtists     AlbumArtist[]
  tracks           Track[]
  albumAnnotations AlbumAnnotation[]

  @@index([createdAt])
  @@index([name])
  @@map("albums")
}

model AlbumArtist {
  albumId  String @map("album_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([artistId])
  @@map("album_artists")
}

// ─── Tracks ───────────────────────────────────────────────────────────────

model Track {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  fileKey     String   @unique @map("file_key")
  albumId     String   @map("album_id") @db.Uuid
  trackNumber Int      @map("track_number")
  discNumber  Int      @default(1) @map("disc_number")
  duration    Int
  size        Int
  codec       String   @db.VarChar(16)
  suffix      String   @db.VarChar(16)
  genres      String[]
  bitRate     Int      @map("bit_rate")
  sampleRate  Int      @map("sample_rate")
  bitDepth    Int?     @map("bit_depth")
  releaseDate DateTime @map("release_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackArtists     TrackArtist[]
  playlistTracks   PlaylistTrack[]
  trackAnnotations TrackAnnotation[]
  playHistories    PlayHistory[]

  @@index([title])
  @@index([albumId, discNumber, trackNumber])
  @@map("tracks")
}

model TrackArtist {
  trackId  String @map("track_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([artistId])
  @@map("track_artists")
}

// ─── Playlists ───────────────────────────────────────────────────────────────

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  public      Boolean  @default(false)
  position    Int
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@unique([ownerId, position])
  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(uuid()) @db.Uuid
  playlistId String @map("playlist_id") @db.Uuid
  trackId    String @map("track_id") @db.Uuid
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
}

// ─── Play History ───────────────────────────────────────────────────────────────

model PlayHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  trackId        String   @map("track_id") @db.Uuid
  playedAt       DateTime @default(now()) @map("played_at")
  durationPlayed Int?     @map("duration_played")
  wasSkipped     Boolean  @default(false) @map("was_skipped")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
  @@index([trackId])
  @@map("play_history")
}

// ─── Annotations ───────────────────────────────────────────────────────────────

model TrackAnnotation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  trackId     String    @map("track_id") @db.Uuid
  starred     Boolean   @default(false)
  starredAt   DateTime? @map("starred_at")
  playCount   Int       @default(0) @map("play_count")
  lastPlayed  DateTime? @map("last_played")
  skipCount   Int       @default(0) @map("skip_count")
  lastSkipped DateTime? @map("last_skipped")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, starred])
  @@index([userId, lastPlayed])
  @@map("track_annotations")
}

model AlbumAnnotation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@map("album_annotations")
}

model ArtistAnnotation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@map("artist_annotations")
}
