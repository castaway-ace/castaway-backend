// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlaylistType {
  USER
  LIKED
}

// ─── User & Auth ───────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  userName     String   @unique @map("user_name")
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  devices              Device[]
  playlists            Playlist[]
  trackAnnotations     TrackAnnotation[]
  albumAnnotations     AlbumAnnotation[]
  artistAnnotations    ArtistAnnotation[]
  albumInteractions    AlbumInteraction[]
  playlistInteractions PlaylistInteraction[]
  artistInteractions   ArtistInteraction[]

  @@map("users")
}

model Device {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  name  String?
  model String?

  activatedAt DateTime @default(now()) @map("activated_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, clientId])
  @@map("devices")
}

model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")

  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("TokenRotation")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Music Entities ───────────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  bio       String?
  imageKey  String?  @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  albumArtists       AlbumArtist[]
  trackArtists       TrackArtist[]
  artistAnnotations  ArtistAnnotation[]
  artistInteractions ArtistInteraction[]

  @@map("artists")
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  releaseDate DateTime @map("release_date") @db.Date
  compilation Boolean  @default(false)
  imageKey    String?  @unique @map("image_key")
  identityKey String   @unique @map("identity_key")
  genres      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now())  @updatedAt @map("updated_at")

  albumArtists      AlbumArtist[]
  tracks            Track[]
  albumAnnotations  AlbumAnnotation[]
  albumInteractions AlbumInteraction[]

  @@index([createdAt])
  @@index([title])
  @@map("albums")
}

model AlbumArtist {
  albumId  String @map("album_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([artistId])
  @@map("album_artists")
}

// ─── Tracks ───────────────────────────────────────────────────────────────

model Track {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  fileKey     String   @unique @map("file_key")
  albumId     String   @map("album_id") @db.Uuid
  trackNumber Int      @map("track_number")
  discNumber  Int      @default(1) @map("disc_number")
  duration    Int
  size        Int
  suffix      String   @db.VarChar(16)
  genres      String[]
  bitRate     Int      @map("bit_rate")
  sampleRate  Int      @map("sample_rate")
  bitDepth    Int?     @map("bit_depth")
  releaseDate DateTime @map("release_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackArtists     TrackArtist[]
  playlistTracks   PlaylistTrack[]
  trackAnnotations TrackAnnotation[]

  @@index([title])
  @@index([albumId, discNumber, trackNumber])
  @@map("tracks")
}

model TrackArtist {
  trackId  String @map("track_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([artistId])
  @@map("track_artists")
}

// ─── Playlists ───────────────────────────────────────────────────────────────

model Playlist {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        PlaylistType @default(USER)
  ownerId     String       @map("owner_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks               PlaylistTrack[]
  playlistInteractions PlaylistInteraction[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(uuid()) @db.Uuid
  playlistId String @map("playlist_id") @db.Uuid
  trackId    String @map("track_id") @db.Uuid
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
}

// ─── Interactions ───────────────────────────────────────────────────────────────

model AlbumInteraction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("album_interactions")
}

model PlaylistInteraction {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("playlist_interactions")
}

model ArtistInteraction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("artist_interactions")
}

// ─── Annotations ───────────────────────────────────────────────────────────────

model TrackAnnotation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  trackId     String    @map("track_id") @db.Uuid
  starred     Boolean   @default(false)
  starredAt   DateTime? @map("starred_at")
  playCount   Int       @default(0) @map("play_count")
  lastPlayed  DateTime? @map("last_played")
  skipCount   Int       @default(0) @map("skip_count")
  lastSkipped DateTime? @map("last_skipped")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, starred, starredAt(sort: Desc)])
  @@index([userId, lastPlayed])
  @@map("track_annotations")
}

model AlbumAnnotation {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  albumId String  @map("album_id") @db.Uuid
  starred Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId, starred])
  @@map("album_annotations")
}

model ArtistAnnotation {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  artistId String  @map("artist_id") @db.Uuid
  starred  Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId, starred])
  @@map("artist_annotations")
}
