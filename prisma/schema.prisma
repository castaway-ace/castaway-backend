// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  Admin
  User
}

enum AuthProvider {
  Google
  Facebook
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?  @unique @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  password    String?
  role        Role     @default(User)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  accounts          Account[]
  refreshTokens     RefreshToken[]
  playlists         Playlist[]
  trackAnnotations  TrackAnnotation[]
  albumAnnotations  AlbumAnnotation[]
  artistAnnotations ArtistAnnotation[]

  @@map("users")
}

model Account {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  providerId String       @map("provider_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  deviceName String?  @map("device_name")
  deviceType String?  @map("device_type")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Music Entities ──────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  imageKey  String?  @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  albumCredits      AlbumArtist[]
  trackCredits      TrackArtist[]
  artistAnnotations ArtistAnnotation[]

  @@index([name])
  @@map("artists")
}

model Album {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  releaseDate     DateTime? @map("release_date") @db.Date
  compilation     Boolean   @default(false)
  genres          String[]
  imageKey        String?   @map("image_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  albumArtists     AlbumArtist[]
  tracks           Track[]
  albumAnnotations AlbumAnnotation[]

  @@index([createdAt])
  @@index([name])
  @@index([genres], type: Gin)
  @@map("albums")
}

model AlbumArtist {
  albumId  String @map("album_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  role     String @default("")

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([role])
  @@map("album_artists")
}

// ─── Tracks ──────────────────────────────────────────────────────────────────

model Track {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  fileKey         String    @unique @map("file_key")
  albumId         String    @map("album_id") @db.Uuid
  trackNumber     Int       @map("track_number")
  size            Int       @default(0)
  suffix          String    @default("") @db.VarChar(255)
  discNumber      Int       @default(0) @map("disc_number")
  bitRate         Int       @default(0) @map("bit_rate")
  releaseDate     DateTime? @map("release_date") @db.Date
  sampleRate      Int       @default(0) @map("sample_rate")
  genres          String[]
  bitDepth        Int       @default(0) @map("bit_depth")
  duration        Int
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  album         Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackArtists     TrackArtist[]
  playlistTracks   PlaylistTrack[]
  trackAnnotations TrackAnnotation[]

  @@index([title])
  @@index([albumId])
  @@index([discNumber, trackNumber])
  @@index([genres], type: Gin)
  @@map("tracks")
}

model TrackArtist {
  trackId  String @map("track_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid
  role     String @default("")
  subRole  String @default("") @map("sub_role")

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([role])
  @@map("track_artists")
}

// ─── Playlists ───────────────────────────────────────────────────────────────

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  public      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  ownerId     String   @map("owner_id") @db.Uuid

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([createdAt])
  @@index([updatedAt])
  @@unique([ownerId, name])
  @@map("playlists")
}

model PlaylistTrack {
  id          String @id @default(uuid()) @db.Uuid
  playlistId  String @map("playlist_id") @db.Uuid
  trackId String @map("track_id") @db.Uuid
  position    Int

  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
}

// ─── Annotations ─────────────────────────────────────────────────────────────

model TrackAnnotation {
  userId      String    @map("user_id") @db.Uuid
  trackId String    @map("track_id") @db.Uuid
  playCount   Int       @default(0) @map("play_count")
  playDate    DateTime? @map("play_date")
  liked       Boolean   @default(false)
  likedAt     DateTime? @map("liked_at")

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@map("track_annotations")
}

model AlbumAnnotation {
  userId  String    @map("user_id") @db.Uuid
  albumId String    @map("album_id") @db.Uuid
  liked   Boolean   @default(false)
  likedAt DateTime? @map("liked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@map("album_annotations")
}

model ArtistAnnotation {
  userId   String    @map("user_id") @db.Uuid
  artistId String    @map("artist_id") @db.Uuid
  liked    Boolean   @default(false)
  likedAt  DateTime? @map("liked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("artist_annotations")
}